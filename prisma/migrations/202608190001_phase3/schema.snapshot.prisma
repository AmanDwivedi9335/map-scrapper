generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum UserStatus { ACTIVE SUSPENDED DELETED }
enum OrganizationStatus { ACTIVE SUSPENDED CANCELLED }
enum OrganizationRole { OWNER ADMIN MEMBER VIEWER }
enum LeadSource { GOOGLE_MAPS CSV_IMPORT MANUAL API }
enum JobType { LEAD_IMPORT ENRICHMENT EXPORT BULK_DELETE BULK_LIST_UPDATE }
enum JobStatus { QUEUED RUNNING PAUSED COMPLETED FAILED CANCELLED PARTIALLY_COMPLETED }
enum SubscriptionStatus { TRIALING ACTIVE PAST_DUE CANCELLED INCOMPLETE EXPIRED }
enum CreditType { PURCHASE PLAN_ALLOCATION ENRICHMENT_USAGE REFUND ADMIN_ADJUSTMENT EXPIRATION PROMOTIONAL }
enum UsageMetric { LEADS_IMPORTED LEADS_STORED ENRICHMENT_REQUESTS EMAIL_DISCOVERIES EXPORT_ROWS API_REQUESTS }
model User { id String @id @default(uuid()) @db.Uuid email String @unique passwordHash String? name String? avatarUrl String? emailVerifiedAt DateTime? status UserStatus @default(ACTIVE) platformAdmin Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt memberships OrganizationMember[] sessions Session[] ownedOrganizations Organization[] @relation("Owner") }
model Organization { id String @id @default(uuid()) @db.Uuid name String slug String @unique ownerUserId String @db.Uuid owner User @relation("Owner",fields:[ownerUserId],references:[id]) status OrganizationStatus @default(ACTIVE) deletionRequestedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt members OrganizationMember[] leads Lead[] lists LeadList[] imports ScrapeImport[] jobs Job[] credits CreditTransaction[] reservations CreditReservation[] usage UsageRecord[] subscriptions Subscription[] invitations TeamInvitation[] audits AuditLog[] extensionSessions ExtensionSession[] }
model OrganizationMember { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) userId String @db.Uuid user User @relation(fields:[userId],references:[id]) role OrganizationRole joinedAt DateTime @default(now()) @@unique([organizationId,userId]) @@index([userId]) }
model Session { id String @id @default(uuid()) @db.Uuid userId String @db.Uuid user User @relation(fields:[userId],references:[id]) refreshTokenHash String @unique familyId String @db.Uuid expiresAt DateTime revokedAt DateTime? replacedById String? ipHash String? userAgent String? createdAt DateTime @default(now()) @@index([userId,expiresAt]) }
model Lead { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) name String primaryCategory String? categories String[] address String? city String? state String? postalCode String? country String? phone String? normalizedPhone String? website String? normalizedWebsite String? rating Decimal? @db.Decimal(3,2) reviewCount Int? latitude Decimal? @db.Decimal(10,7) longitude Decimal? @db.Decimal(10,7) mapsUrl String? normalizedMapsUrl String? placeId String? source LeadSource createdByUserId String @db.Uuid scrapeImportId String? @db.Uuid scrapeImport ScrapeImport? @relation(fields:[scrapeImportId],references:[id]) deletedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt emails LeadEmail[] socials LeadSocialProfile[] metadata LeadWebsiteMetadata? listMemberships LeadListMember[] @@unique([organizationId,placeId]) @@index([organizationId,createdAt]) @@index([organizationId,name]) @@index([organizationId,normalizedWebsite]) @@index([organizationId,normalizedPhone]) }
model LeadEmail { id String @id @default(uuid()) @db.Uuid leadId String @db.Uuid lead Lead @relation(fields:[leadId],references:[id]) email String type String confidence Decimal? @db.Decimal(4,3) verificationStatus String? discoveredAt DateTime @default(now()) @@unique([leadId,email]) }
model LeadSocialProfile { id String @id @default(uuid()) @db.Uuid leadId String @db.Uuid lead Lead @relation(fields:[leadId],references:[id]) network String url String discoveredAt DateTime @default(now()) @@unique([leadId,network,url]) }
model LeadWebsiteMetadata { id String @id @default(uuid()) @db.Uuid leadId String @unique @db.Uuid lead Lead @relation(fields:[leadId],references:[id]) title String? description String? technologies String[] lastCrawledAt DateTime? }
model LeadList { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) name String description String? createdByUserId String @db.Uuid deletedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt members LeadListMember[] @@index([organizationId,createdAt]) }
model LeadListMember { listId String @db.Uuid list LeadList @relation(fields:[listId],references:[id]) leadId String @db.Uuid lead Lead @relation(fields:[leadId],references:[id]) addedByUserId String @db.Uuid addedAt DateTime @default(now()) @@id([listId,leadId]) @@index([leadId]) }
model ScrapeImport { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) createdByUserId String @db.Uuid extensionJobId String idempotencyKey String batchNumber Int searchKeyword String? searchLocation String? extensionVersion String receivedCount Int createdCount Int updatedCount Int duplicateCount Int rejectedCount Int importedAt DateTime @default(now()) leads Lead[] @@unique([organizationId,idempotencyKey]) @@unique([organizationId,extensionJobId,batchNumber]) @@index([organizationId,importedAt]) }
model Job { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) createdByUserId String @db.Uuid type JobType status JobStatus @default(QUEUED) totalItems Int processedItems Int @default(0) successItems Int @default(0) failedItems Int @default(0) reservedCredits Int @default(0) consumedCredits Int @default(0) heartbeatAt DateTime? startedAt DateTime? completedAt DateTime? errorCode String? errorMessage String? requestId String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt items JobItem[] reservations CreditReservation[] @@index([organizationId,status]) @@index([status,heartbeatAt]) }
model JobItem { id String @id @default(uuid()) @db.Uuid jobId String @db.Uuid job Job @relation(fields:[jobId],references:[id]) resourceId String status JobStatus attempts Int @default(0) errorCode String? errorMessage String? updatedAt DateTime @updatedAt @@unique([jobId,resourceId]) @@index([jobId,status]) }
model CreditTransaction { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) type CreditType amount Int balanceAfter Int referenceType String? referenceId String? description String createdAt DateTime @default(now()) @@unique([organizationId,referenceType,referenceId,type]) @@index([organizationId,createdAt]) }
model CreditReservation { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) jobId String @unique @db.Uuid job Job @relation(fields:[jobId],references:[id]) amount Int consumed Int @default(0) releasedAt DateTime? createdAt DateTime @default(now()) @@index([organizationId,releasedAt]) }
model PlanDefinition { code String @id maxUsers Int maxCloudLeads Int monthlyCredits Int maxConcurrentJobs Int allowedExports String[] enrichmentEnabled Boolean creditsRollover Boolean active Boolean @default(true) updatedAt DateTime @updatedAt }
model UsageRecord { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) metric UsageMetric quantity Int referenceId String? occurredAt DateTime @default(now()) @@unique([organizationId,metric,referenceId]) @@index([organizationId,occurredAt]) }
model Subscription { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) provider String providerCustomerId String? providerSubscriptionId String? planCode String status SubscriptionStatus currentPeriodStart DateTime? currentPeriodEnd DateTime? cancelAtPeriodEnd Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([organizationId,status]) @@unique([provider,providerSubscriptionId]) }
model WebhookEvent { id String @id @default(uuid()) @db.Uuid provider String externalEventId String eventType String payloadHash String processedAt DateTime @default(now()) @@unique([provider,externalEventId]) }
model TeamInvitation { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) email String role OrganizationRole tokenHash String @unique expiresAt DateTime acceptedAt DateTime? rejectedAt DateTime? revokedAt DateTime? invitedByUserId String @db.Uuid createdAt DateTime @default(now()) @@index([organizationId,email]) }
model AuditLog { id String @id @default(uuid()) @db.Uuid organizationId String? @db.Uuid organization Organization? @relation(fields:[organizationId],references:[id]) userId String? @db.Uuid action String resourceType String? resourceId String? metadata Json? requestId String createdAt DateTime @default(now()) @@index([organizationId,createdAt]) }
model ExtensionSession { id String @id @default(uuid()) @db.Uuid organizationId String @db.Uuid organization Organization @relation(fields:[organizationId],references:[id]) userId String @db.Uuid tokenHash String @unique extensionVersion String lastSyncAt DateTime? lastImportAt DateTime? expiresAt DateTime revokedAt DateTime? createdAt DateTime @default(now()) @@index([organizationId,revokedAt]) }
model PasswordToken { id String @id @default(uuid()) @db.Uuid userId String @db.Uuid purpose String tokenHash String @unique expiresAt DateTime usedAt DateTime? createdAt DateTime @default(now()) @@index([userId,purpose]) }
